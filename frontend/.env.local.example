# Frontend environment (copy to .env.local)

# Backend base URL used by the Next.js rewrite proxy (server-side).
BACKEND_URL=http://localhost:8000

# Optional: if you want the browser to hit the backend directly instead of
# going through the Next.js /api rewrite proxy, set this to the backend origin.
# Leaving it blank uses same-origin relative URLs (recommended).
# NEXT_PUBLIC_API_BASE_URL=
