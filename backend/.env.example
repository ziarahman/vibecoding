# ---------------------------------------------------------------------------
# IPO Signal Intelligence — backend environment
# Copy to `.env` and fill in as needed. Everything has a sane default so the
# app runs with ZERO configuration (heuristic mode, SQLite, seed data).
# ---------------------------------------------------------------------------

# --- App ---
ENVIRONMENT=development

# --- Database (SQLite by default; swap for Postgres) ---
DATABASE_URL=sqlite:///./ipo_signals.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ipo

# --- CORS (frontend origins) ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- LLM provider switch: ollama | openai | anthropic ---
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.0

# Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI (cloud)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (cloud)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Discovery ---
# TAVILY_API_KEY=tvly-...
DISCOVERY_MAX_DOCUMENTS=12
